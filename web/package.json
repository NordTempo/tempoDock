{
  "name": "@tempodock/web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite",
    "dev:tempobase": "vite --config vite.tempobase.config.ts",
    "dev:tempobase:memory": "VITE_TEMPOBASE_MEMORY=1 vite --config vite.tempobase.config.ts",
    "build": "pnpm build:dock && pnpm build:tempobase",
    "build:dock": "vite build",
    "build:tempobase": "vite build --config vite.tempobase.config.ts",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts && openapi-typescript tempobase/openapi.json -o tempobase/src/api/schema.d.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tempobase",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm check:api && pnpm check:recorder",
    "check:api": "openapi-typescript openapi.json --check -o src/api/schema.d.ts && openapi-typescript tempobase/openapi.json --check -o tempobase/src/api/schema.d.ts",
    "build:recorder": "vite build --config vite.recorder.config.ts",
    "check:recorder": "RECORDER_OUT=node_modules/.recorder-check vite build --config vite.recorder.config.ts --logLevel error && cmp node_modules/.recorder-check/r.js ../internal/analytics/ingest/recorder/r.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@glideapps/glide-data-grid": "6.0.3",
    "@lezer/highlight": "1.2.5",
    "@rrweb/replay": "2.2.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "lodash": "4.18.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@rrweb/record": "2.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.47",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
