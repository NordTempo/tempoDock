---
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import Page from "../layouts/Page.astro";

/** The page for a path the site doesn't have (the Caddyfile's handle_errors). */
---

<Page title="Not found · Tempo Dock" description="This page doesn't exist.">
  <Nav />
  <main class="mx-auto max-w-[1200px] px-6 py-28 md:px-14">
    <h1 class="heading">Nothing here.</h1>
    <p class="mt-6 mb-8 text-[19px] text-sub">This page doesn't exist. The docs and the home page do.</p>
    <div class="flex flex-wrap gap-3">
      <Button href="/docs">Read the docs</Button>
      <Button href="/" variant="secondary">Home</Button>
    </div>
  </main>
  <Footer />
</Page>
