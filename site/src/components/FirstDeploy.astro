---
import { install } from "../site";
import Section from "./Section.astro";

/**
 * From a new server to a live app in four commands, each with the guide
 * that explains it, one row each. The commands are the guides' own; one too
 * long for its row wraps after a path slash (<wbr>), or anywhere if it must.
 */
const steps = [
  ["Install the server", install.server, "Install", "/docs/install"],
  ["Sign in from your laptop", install.cli, "The CLI", "/docs/install#the-cli"],
  ["Deploy", "dock deploy", "Getting started", "/docs/getting-started"],
  [
    "Give it a domain",
    "dock domain add shop.example.com",
    "Domains",
    "/docs/domains",
  ],
] as const;
---

<Section id="start" title="From a server to a live app." dim="Four commands.">
  <ol class="border-t border-line">
    {steps.map(([title, command, guide, href], n) => (
      <li class="grid grid-cols-[28px_minmax(0,1fr)] items-baseline gap-x-4 gap-y-2 border-b border-line py-4 lg:grid-cols-[28px_220px_minmax(0,1fr)_auto]">
        <p class="font-mono text-xs text-deploys">{n + 1}</p>
        <h3 class="font-semibold">{title}</h3>
        <pre class="col-start-2 whitespace-pre-wrap font-mono text-xs text-white [overflow-wrap:anywhere] lg:col-start-auto"><code class="select-all [font-variant-ligatures:none]">{command.split(/(?<=[^/:]\/)/).map((part, i) => <>{i > 0 && <wbr />}{part}</>)}</code></pre>
        <a href={href} class="col-start-2 text-sm whitespace-nowrap text-body hover:text-white lg:col-start-auto">{guide} →</a>
      </li>
    ))}
  </ol>
</Section>
