---
import Section from "./Section.astro";

/** The feature grid: what Dock does after a push, four columns on wide screens. */
const features = [
  {
    key: "DEPLOYS",
    color: "text-deploys",
    title: "Push, get a release.",
    items: [
      "Preview per pull request",
      "Migrations before traffic",
      "Rollbacks in one step",
    ],
  },
  {
    key: "DIAGNOSIS",
    color: "text-deploys",
    title: "Says why it failed.",
    items: [
      "Missing variables, wrong ports",
      "Memory limits, crash loops",
      "The evidence, kept",
    ],
  },
  {
    key: "SLEEP",
    color: "text-deploys",
    title: "Idle costs nothing.",
    items: [
      "Previews sleep when idle",
      "Wake on the next request",
      "Staging can sleep too",
    ],
  },
  {
    key: "DOMAINS",
    color: "text-domains",
    title: "TLS without thinking.",
    items: [
      "Automatic certificates",
      "Cloudflare DNS and redirects",
      "Password or login in front",
    ],
  },
  {
    key: "ERRORS",
    color: "text-errors",
    title: "Linked to the release.",
    items: [
      "Frontend, logs and 5xx",
      "Alerts per organization",
      "Log history and drains",
    ],
  },
  {
    key: "TRACES",
    color: "text-traces",
    title: "Every request, inside.",
    items: ["OpenTelemetry in", "Latency per route", "App metric dashboards"],
  },
  {
    key: "ANALYTICS",
    color: "text-analytics",
    title: "Traffic, on your box.",
    items: ["Visits, vitals, trends", "Goals and funnels", "Uptime checks"],
  },
  {
    key: "STATUS",
    color: "text-status",
    title: "Tell users first.",
    items: [
      "Incidents and maintenance",
      "Uptime from Dock's checks",
      "Your own hostname",
    ],
  },
  {
    key: "DATA",
    color: "text-data",
    title: "Databases you can see.",
    items: [
      "Postgres, MySQL, Redis",
      "Reviewed changesets",
      "Health and slow queries",
    ],
  },
  {
    key: "BACKUPS",
    color: "text-data",
    title: "Restores you have tried.",
    items: [
      "Daily, to any S3 bucket",
      "Volume snapshots",
      "Restores in one step",
    ],
  },
  {
    key: "SECURITY",
    color: "text-errors",
    title: "Know what you ship.",
    items: ["Live images scanned", "Fixes per base image", "SBOM export"],
  },
  {
    key: "JOBS",
    color: "text-neutral-200",
    title: "More than web servers.",
    items: ["Cron jobs", "One-off commands, dock run", "Tunnels, dock connect"],
  },
  {
    key: "CONFIG",
    color: "text-neutral-200",
    title: "Config as code.",
    items: [
      "dock.toml in the repo",
      "dock apply, Compose import",
      "Clone an environment",
    ],
  },
  {
    key: "SERVERS",
    color: "text-neutral-200",
    title: "Grow past one box.",
    items: [
      "Environments per server",
      "Moves without downtime",
      "Updates from the console",
    ],
  },
  {
    key: "AGENTS",
    color: "text-agents",
    title: "Built for them.",
    items: ["MCP endpoint", "--json on every command", "Approval requests"],
  },
  {
    key: "ACCESS",
    color: "text-neutral-200",
    title: "Teams, done right.",
    items: ["Organizations and roles", "SSO, passkeys, 2FA", "Audit log"],
  },
];
---

<Section id="features" title="Everything after git push." dim="Sixteen things you stop building.">
  <div class="grid border-t border-line sm:grid-cols-2 lg:grid-cols-4">
    {features.map((f) => (
      <div class="border-b border-line py-6 pr-6 sm:[&:nth-child(2n)]:border-l sm:[&:nth-child(2n)]:pl-6 lg:[&:nth-child(2n)]:border-l-0 lg:[&:nth-child(2n)]:pl-0 lg:[&:not(:nth-child(4n+1))]:border-l lg:[&:not(:nth-child(4n+1))]:pl-6">
        <p class:list={["eyebrow mb-3", f.color]}>{f.key}</p>
        <h3 class="text-[22px] font-semibold tracking-[-0.02em]">{f.title}</h3>
        <ul class="mt-3 text-sm leading-[1.75] text-body">
          {f.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</Section>
