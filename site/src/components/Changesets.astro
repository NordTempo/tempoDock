---
import type { Line } from "../terminal";
import Section from "./Section.astro";
import Terminal from "./Terminal.astro";

/** An agent proposes a data change with `dock db`; a person commits it. Real commands and messages. */

const agent: Line[] = [
  { text: "$ dock db apply -f trials.json --dry-run", tone: "cmd" },
  { text: "  UPDATE users SET plan = 'pro' WHERE id = 1042;", tone: "info" },
  { text: "  UPDATE users SET plan = 'pro' WHERE id = 1043;", tone: "info" },
  { text: '$ dock db apply -f trials.json -m "upgrade trials"', tone: "cmd" },
  { text: "✓ Proposed changeset 7 (2 changes)", tone: "ok" },
];

const you: Line[] = [
  { text: "$ dock db changes show 7", tone: "cmd" },
  { text: "  author   token claude-code", tone: "meta" },
  { text: "  UPDATE users SET plan = 'pro' WHERE id = 1042;", tone: "info" },
  { text: "  UPDATE users SET plan = 'pro' WHERE id = 1043;", tone: "info" },
  { text: "$ dock db changes commit 7 --confirm production", tone: "cmd" },
  { text: "✓ Committed changeset 7: 2 rows affected", tone: "ok" },
];

const panels = [
  {
    label: "YOUR AGENT",
    tag: "PROPOSES",
    tagClass: "bg-[#1d1638] text-agents",
    border: "border-[#222]",
    lines: agent,
  },
  {
    label: "YOU",
    tag: "COMMIT",
    tagClass: "bg-[#0f2e1a] text-deploys",
    border: "border-[#1b2a3d]",
    lines: you,
  },
];
---

<Section id="changesets" title="Agents propose." dim="You commit.">
  <Fragment slot="aside">
    Agents read your data through the same CLI and MCP endpoint, with sensitive columns masked. Changes to production
    wait as a changeset until a person commits it.
  </Fragment>
  <div class="grid gap-5 lg:grid-cols-2">
    {panels.map((panel) => (
      <div class:list={["min-w-0 border bg-panel px-4 py-5 sm:px-6", panel.border]}>
        <div class="mb-4 flex items-center justify-between">
          <span class="eyebrow text-meta">{panel.label}</span>
          <span class:list={["eyebrow px-1.5 py-0.5", panel.tagClass]}>{panel.tag}</span>
        </div>
        <Terminal lines={panel.lines} />
      </div>
    ))}
  </div>
</Section>
