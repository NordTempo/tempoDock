---
import { earlyAccessHref, site } from "../site";
import Button from "./Button.astro";
import Logo from "./Logo.astro";

const links = [
  ["Deploys", "#ship"],
  ["Data", "#data"],
  ["Agents", "#agents"],
  ["Features", "#features"],
  ["Performance", "#performance"],
] as const;
---

<nav class="mx-auto flex max-w-[1200px] items-center gap-3 px-6 pt-7 sm:gap-8 md:px-14">
  <a href="/" class="sm:mr-3"><Logo /></a>
  {links.map(([label, href]) => (
    <a href={href} class="hidden text-[15px] text-neutral-400 hover:text-white lg:inline">{label}</a>
  ))}
  <span class="flex-1"></span>
  <a href={site.consoleUrl} class="hidden text-[15px] text-neutral-400 hover:text-white sm:inline">Sign in</a>
  <Button href={earlyAccessHref} size="sm">Get early access →</Button>
</nav>
