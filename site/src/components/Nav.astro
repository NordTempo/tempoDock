---
import { site } from "../site";
import Button from "./Button.astro";
import Logo from "./Logo.astro";

/** The header: the docs, then the home page's sections. */
interface Props {
  /** The part of the site the page belongs to, shown as the open link. */
  current?: "docs";
}

const { current } = Astro.props;
const links = [
  ["Deploys", "/#ship"],
  ["Data", "/#data"],
  ["Agents", "/#agents"],
  ["Features", "/#features"],
  ["Performance", "/#performance"],
] as const;
---

<nav class="mx-auto flex max-w-[1200px] items-center gap-5 px-6 pt-7 sm:gap-8 md:px-14">
  <a href="/" class="sm:mr-3"><Logo /></a>
  <a href="/docs" class:list={["text-[15px] hover:text-white", current === "docs" ? "text-white" : "text-neutral-400"]}>Docs</a>
  {links.map(([label, href]) => (
    <a href={href} class="hidden text-[15px] text-neutral-400 hover:text-white lg:inline">{label}</a>
  ))}
  <span class="flex-1"></span>
  <Button href={site.repoUrl} size="sm">GitHub →</Button>
</nav>
