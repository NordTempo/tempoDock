---
import type { Line } from "../terminal";
import Section from "./Section.astro";
import Terminal from "./Terminal.astro";

const hope: Line[] = [
  { text: "$ ssh prod", tone: "cmd" },
  { text: "$ docker compose pull && docker compose up -d", tone: "cmd" },
  { text: "  web  Recreated", tone: "meta" },
  { text: "  web  exited with code 1", tone: "bad" },
  { text: "  502 Bad Gateway", tone: "bad" },
  { text: "  ... rolling back by hand", tone: "meta" },
];

const dock: Line[] = [
  { text: "$ dock deploy", tone: "cmd" },
  { text: "  release v42 built in 38s", tone: "meta" },
  { text: "  health check failed: exited with code 1", tone: "bad" },
  { text: "  traffic stays on v41", tone: "ok" },
  { text: "  why: dock logs -r 42", tone: "meta" },
  { text: "  downtime 0s", tone: "ok" },
];

const panels = [
  {
    label: "DEPLOY AND HOPE",
    tag: "DOWN 3M 12S",
    tagClass: "bg-[#3b1212] text-errors",
    border: "border-[#222]",
    lines: hope,
  },
  {
    label: "TEMPO DOCK",
    tag: "LIVE ON V41",
    tagClass: "bg-[#0f2e1a] text-deploys",
    border: "border-[#1f3a28]",
    lines: dock,
  },
];
---

<Section id="releases" title="A failed deploy" dim="never gets traffic.">
  <Fragment slot="aside">
    Every deploy and every config change is a release. Dock health-checks it before it gets traffic and keeps the last
    one ready to roll back.
  </Fragment>
  <div class="grid gap-5 lg:grid-cols-2">
    {panels.map((panel) => (
      <div class:list={["min-w-0 border bg-panel px-4 py-5 sm:px-6", panel.border]}>
        <div class="mb-4 flex items-center justify-between">
          <span class="eyebrow text-meta">{panel.label}</span>
          <span class:list={["eyebrow px-1.5 py-0.5", panel.tagClass]}>{panel.tag}</span>
        </div>
        <Terminal lines={panel.lines} />
      </div>
    ))}
  </div>
</Section>
