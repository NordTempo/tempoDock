---
import Section from "./Section.astro";

/** The Data tab as an illustration: a table with one staged edit, its SQL and the production confirm. */

const cols = ["id", "email", "plan", "created"];
const rows = [
  ["1040", "masked", "pro", "2 days ago"],
  ["1041", "masked", "free", "2 days ago"],
  ["1042", "masked", "trial", "yesterday"],
  ["1043", "masked", "free", "5 hours ago"],
  ["1044", "masked", "pro", "1 hour ago"],
];
const staged = 2;
---

<Section id="data" title="See your data." dim="Change it on purpose.">
  <Fragment slot="aside">
    Every Postgres service gets a Data tab. Browse tables, run queries, edit rows. Edits are staged, shown as SQL and
    committed in one transaction.
  </Fragment>
  <div class="min-w-0 border border-[#1b2a3d] bg-panel">
    <div class="flex items-center justify-between border-b border-line px-4 py-3 sm:px-6">
      <span class="eyebrow text-meta">SHOP / PRODUCTION / POSTGRES · USERS</span>
      <span class="eyebrow bg-[#2a2208] px-1.5 py-0.5 text-domains">EDIT MODE</span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full font-mono text-[13px]">
        <thead>
          <tr class="text-left text-meta">
            {cols.map((c, k) => (
              <th class:list={["border-b border-line px-4 py-2.5 font-normal sm:px-6", k === 3 && "hidden sm:table-cell"]}>{c}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r, k) => (
            <tr class:list={[k === staged && "bg-[#1a1505]"]}>
              {r.map((cell, c) => (
                <td class:list={["border-b border-line px-4 py-2 sm:px-6", c === 1 ? "text-dim italic" : "text-sub", c === 3 && "hidden sm:table-cell"]}>
                  {k === staged && c === 2 ? (
                    <span><span class="text-dim line-through">trial</span> <span class="text-domains">pro</span></span>
                  ) : cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="grid gap-4 px-4 py-5 sm:px-6 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="min-w-0">
        <p class="eyebrow mb-2 text-meta">1 CHANGE · REVIEW</p>
        <pre class="overflow-x-auto font-mono text-[13px] leading-[23px] text-sub">UPDATE "users" SET "plan" = 'pro' WHERE "id" = 1042;</pre>
      </div>
      <div class="flex flex-wrap items-center gap-3 font-mono text-[13px]">
        <span class="w-full text-meta sm:w-auto">type production to commit</span>
        <span class="border border-edge px-3 py-1.5 text-white">production</span>
        <span class="bg-white px-3 py-1.5 font-sans text-sm font-semibold text-black">Commit</span>
      </div>
    </div>
  </div>
</Section>
