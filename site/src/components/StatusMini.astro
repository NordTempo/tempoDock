---
/** A public status page in miniature: 90 days of uptime per component, one incident. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const days = 60;
const bad: Record<string, number[]> = { Checkout: [41], API: [41, 12] };
const components = ["Website", "API", "Checkout"].map((name) => ({
  name,
  bars: Array.from({ length: days }, (_, d) =>
    bad[name]?.includes(d) ? (d === 41 ? 2 : 1) : 0,
  ),
  pct: name === "Website" ? "100%" : name === "API" ? "99.97%" : "99.91%",
}));
const barClass = ["bg-[#1f6e3c]", "bg-domains", "bg-errors"];
---
<div class:list={["min-w-0 border border-[#3a1a2c] bg-panel px-4 py-5 sm:px-6", className]}>
  <div class="mb-5 flex items-center justify-between">
    <span class="eyebrow text-meta">STATUS.SHOP.NO</span>
    <span class="eyebrow bg-[#0f2e1a] px-1.5 py-0.5 text-deploys">ALL SYSTEMS OPERATIONAL</span>
  </div>
  {components.map((c) => (
    <div class="mb-4">
      <div class="mb-1.5 flex justify-between font-mono text-[12.5px]">
        <span class="text-sub">{c.name}</span>
        <span class="text-dim">{c.pct}</span>
      </div>
      <div class="flex h-6 gap-[2px]">
        {c.bars.map((b) => <span class:list={["flex-1", barClass[b]]}></span>)}
      </div>
    </div>
  ))}
  <div class="mt-5 border-t border-line pt-4 font-mono text-[12.5px] leading-[21px]">
    <p><span class="text-deploys">Resolved</span> <span class="text-sub">Slow checkout</span> <span class="text-dim">· Oct 3, 41 min</span></p>
    <p><span class="text-analytics">Scheduled</span> <span class="text-sub">Database upgrade</span> <span class="text-dim">· Sun 02:00, 20 min</span></p>
  </div>
</div>
