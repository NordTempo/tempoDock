# Serves the built site on :8080 for Dock, which terminates TLS in front.
# A path the site doesn't have gets its 404 page.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	header /fonts/* Cache-Control "public, max-age=604800"

	# The one-line installs (README, install.sh, the console): a small script
	# (public/install.sh, public/cli.sh) that runs the latest release's
	# install.sh or install-cli.sh once it matches the release's signed
	# SHA256SUMS. Plain text, so a browser shows it, and checked again on
	# every request, so a new one takes over at once.
	@installs path /install.sh /cli.sh
	header @installs {
		Content-Type "text/plain; charset=utf-8"
		Cache-Control "no-cache"
		X-Content-Type-Options "nosniff"
	}

	# A page is a file (docs.html, docs/install.html) served without its
	# extension, and without a trailing slash.
	handle {
		@slash path_regexp slash ^(.+)/$
		redir @slash {re.slash.1} 308
		try_files {path}.html {path}
		file_server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
