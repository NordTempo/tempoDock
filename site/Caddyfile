# Serves the built site on :8080 for Dock, which terminates TLS in front.
# Paths the site doesn't have go to the console with a 308, so links to the
# console's old address (invites, deep links) keep working after the move.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	@site path / /index.html /_astro/* /fonts/* /favicon.svg /robots.txt
	handle @site {
		header /_astro/* Cache-Control "public, max-age=31536000, immutable"
		header /fonts/* Cache-Control "public, max-age=604800"
		file_server
	}

	# The one-line installs (README, install.sh, the console): the latest
	# release's scripts, which check everything they download against the
	# release's signed SHA256SUMS. 302, so a new release takes over at once.
	handle /install.sh {
		redir https://github.com/NordTempo/tempoDock/releases/latest/download/install.sh 302
	}
	handle /cli.sh {
		redir https://github.com/NordTempo/tempoDock/releases/latest/download/install-cli.sh 302
	}

	handle {
		redir {$CONSOLE_URL:https://console.nordtempo.com}{uri} 308
	}
}
