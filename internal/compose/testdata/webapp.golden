# Tempo Dock project linkding-stack, exported with `dock project export`.
# Settings as they are live. Secrets are names only (variables); values holds only references.
# Apply it with `dock apply FILE --plan`, then without --plan to stage it.

version = 1
project = 'linkding-stack'

[[environments]]
  name = 'production'
  kind = 'production'

  [[environments.services]]
    name = 'cache'
    template = 'redis'

  [[environments.services]]
    name = 'db'
    template = 'postgres'

    [environments.services.values]
      POSTGRES_DB = 'linkding'
      POSTGRES_USER = 'linkding'

  [[environments.services]]
    name = 'web'
    image = 'ghcr.io/example/linkding:1.36'
    port = 9090
    health_check_path = '/health'
    health_check_timeout_seconds = 110
    memory_mb = 512
    cpus = 0.5
    variables = ['SECRET_KEY']
    depends_on = ['cache', 'db']
    volumes = [{name = 'uploads', mount_path = '/etc/linkding/data'}]
    domains = [{hostname = '', generated = true}]

    [environments.services.values]
      ALLOWED_HOSTS = '*'
      DATABASE_URL = '${{db.DATABASE_URL}}?sslmode=disable'
      DB_PASSWORD = '${{db.POSTGRES_PASSWORD}}'
      DEBUG = 'false'
      REDIS_URL = '${{cache.REDIS_URL}}/0'

# warnings
 | name | The Compose project "Linkding_Stack" is named "linkding-stack" in Dock: project names are 1-32 lowercase letters, digits or dashes.
cache | image | redis:7 becomes Dock's redis template, which brings its own volume, port, health check and backups, so the service's ports, volumes, health check and command aren't used.
cache | image | The redis template requires a password (REDIS_PASSWORD, generated). ${{cache.REDIS_URL}} includes it; services that connect by host and port need ${{cache.REDIS_PASSWORD}} as their password.
db | POSTGRES_PASSWORD | The postgres template generates its own password, so this value isn't used. Other services' variables that held it now reference ${{db.POSTGRES_PASSWORD}}.
db | image | postgres:16-alpine becomes Dock's postgres template, which brings its own volume, port, health check and backups, so the service's ports, volumes, health check and command aren't used. Data in the Compose volumes isn't moved: the new database starts empty.
db | image | The postgres template runs PostgreSQL 17, and the Compose file uses postgres:16-alpine. To move data from the old database, dump it with pg_dump and restore it into the new one.
web | DATABASE_URL | DATABASE_URL points at db, so it now uses the postgres template's DATABASE_URL: ${{db.DATABASE_URL}}?sslmode=disable.
web | DB_PASSWORD | DB_PASSWORD matches db's POSTGRES_PASSWORD in the Compose file, so it now references ${{db.POSTGRES_PASSWORD}}.
web | REDIS_URL | REDIS_URL points at cache, so it now uses the redis template's REDIS_URL: ${{cache.REDIS_URL}}/0.
web | container_name | Dock names containers itself, so container_name is ignored. Other services in the environment reach this one at web.
web | logging | Dock keeps every service's logs itself (`dock logs`), so the logging settings are ignored.
web | ports | Dock doesn't publish host ports, so 9090:9090 isn't opened on the server. HTTP reaches port 9090 through a generated domain when the server has a base domain; add your own with `dock domain add <hostname> -s web`.

# secrets
web SECRET_KEY (value set)

# builds
