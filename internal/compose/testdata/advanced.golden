# Tempo Dock project app, exported with `dock project export`.
# Settings as they are live. Secrets are names only (variables); values holds only references.
# Apply it with `dock apply FILE --plan`, then without --plan to stage it.

version = 1
project = 'app'

[[environments]]
  name = 'production'
  kind = 'production'

  [[environments.services]]
    name = 'api'
    image = 'ghcr.io/acme/api@sha256:0f8a6f5e8b4c7d9e2a1b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5e6f7081'
    port = 8080
    memory_mb = 512
    cpus = 1.5
    variables = ['ADMIN_PASSWORD_FILE']
    depends_on = ['db']
    domains = [{hostname = '', generated = true}]

    [environments.services.values]
      DATABASE_URL = '${{db.DATABASE_URL}}'

  [[environments.services]]
    name = 'db'
    template = 'postgres'

    [environments.services.values]
      POSTGRES_USER = 'app'

  [[environments.services]]
    name = 'debug'
    image = 'nicolaka/netshoot'
    start_command = 'sleep infinity'

  [[environments.services]]
    name = 'worker'
    image = 'ghcr.io/acme/api:2.3.1'
    start_command = 'worker --concurrency 4'
    depends_on = ['api']

# warnings
 | configs | Compose configs aren't supported; build those files into the image instead.
 | secrets | Compose secrets aren't supported. Set each value as a secret variable with `dock env set` instead.
api | DATABASE_URL | DATABASE_URL points at db, so it now uses the postgres template's DATABASE_URL: ${{db.DATABASE_URL}}.
api | configs | Compose configs (files mounted into the container) aren't supported; build them into the image instead.
api | deploy.resources.reservations | Dock sets limits, not reservations, so deploy.resources.reservations is ignored.
api | init | init isn't supported by Dock, so it is not applied.
api | logging | Dock keeps every service's logs itself (`dock logs`), so the logging settings are ignored.
api | ports | Dock doesn't publish host ports, so 8080:8080 isn't opened on the server. HTTP reaches port 8080 through a generated domain when the server has a base domain; add your own with `dock domain add`.
api | secrets | Compose secrets (files under /run/secrets) aren't supported. Set each value as a secret variable with `dock env set` instead.
api | stop_grace_period | stop_grace_period isn't supported by Dock, so it is not applied.
db | POSTGRES_PASSWORD | The postgres template generates its own password, so this value isn't used. Other services' variables that held it now reference ${{db.POSTGRES_PASSWORD}}.
db | image | postgres:17 becomes Dock's postgres template, which brings its own volume, port, health check and backups, so the service's ports, volumes, health check and command aren't used. Data in the Compose volumes isn't moved: the new database starts empty.
db | init | init isn't supported by Dock, so it is not applied.
db | logging | Dock keeps every service's logs itself (`dock logs`), so the logging settings are ignored.
db | stop_grace_period | stop_grace_period isn't supported by Dock, so it is not applied.
debug | profiles | profiles aren't supported, so the service is imported whatever its profile.
worker | init | init isn't supported by Dock, so it is not applied.
worker | logging | Dock keeps every service's logs itself (`dock logs`), so the logging settings are ignored.
worker | profiles | profiles aren't supported, so the service is imported whatever its profile.
worker | stop_grace_period | stop_grace_period isn't supported by Dock, so it is not applied.

# secrets
api ADMIN_PASSWORD_FILE (value set)

# builds
