# Tempo Dock project app, exported with `dock project export`.
# Settings as they are live. Secrets are names only (variables); values holds only references.
# Apply it with `dock apply FILE --plan`, then without --plan to stage it.

version = 1
project = 'app'

[[environments]]
  name = 'production'
  kind = 'production'

  [[environments.services]]
    name = 'db'
    image = 'mysql:8.0'
    variables = ['MYSQL_ROOT_PASSWORD']
    volumes = [{name = 'db', mount_path = '/var/lib/mysql'}]

  [[environments.services]]
    name = 'ghost'
    image = 'ghost:5-alpine'
    port = 2368
    variables = ['database__connection__password']
    depends_on = ['db']
    volumes = [{name = 'ghost', mount_path = '/var/lib/ghost/content'}]

    [environments.services.values]
      database__client = 'mysql'
      database__connection__database = 'ghost'
      database__connection__host = 'db'
      database__connection__user = 'root'
      url = 'http://localhost:2368'

# warnings
db | healthcheck | The health check (mysqladmin ping -h localhost) isn't used: Dock checks an HTTP path on the service's port. Set one with `dock service update --health-check-path` if the service has one.
db | image | Dock has no template for mysql:8.0, so it runs as an image service with its own volume, and Dock doesn't back it up. Back it up yourself.
db | restart | Dock restarts a service every time it stops, so the limit in restart: on-failure:5 isn't applied.
ghost | ports | Port 127.0.0.1:2368:2368 is published only on the host's loopback (127.0.0.1) in Compose, so it isn't public there either, and the service gets no domain. Other services reach it at ghost:2368; to make it public, add a domain with `dock domain add <hostname> -s ghost`.

# secrets
db MYSQL_ROOT_PASSWORD (value set)
ghost database__connection__password (value set)

# builds
