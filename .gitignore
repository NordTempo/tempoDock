/bin/
# `go build ./cmd/dock` at the root writes the binary here; bin/dock is make build's.
/dock
/dist/
/web/dist/*
!/web/dist/.gitkeep
/web/tempobase/dist/*
!/web/tempobase/dist/.gitkeep
/web/node_modules/
/.data/
*.test
coverage.out
/internal/node/probe/bin/*
!/internal/node/probe/bin/.gitkeep
# `go build ./scripts/perf` writes its binary here (it was committed once, #386).
/perf
