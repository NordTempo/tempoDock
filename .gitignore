/bin/
# What `go build ./<package>` writes at the root, one name per main
# package (go list -f '{{if eq .Name "main"}}{{.ImportPath}}{{end}}' ./...);
# make build's binaries go to bin/. dock and perf were committed this way
# once (#339/#340, #386); scripts/ci/no-binaries.sh catches any other.
/dock
/dock-cli
/dock-probe
/dock-sync
/dock-demo
/dock-analytics
/tempobase
/perf
/agenteval
/hammer
/sign
/templates
/dist/
/web/dist/*
!/web/dist/.gitkeep
/web/tempobase/dist/*
!/web/tempobase/dist/.gitkeep
/web/node_modules/
/.data/
*.test
coverage.out
/internal/node/probe/bin/*
!/internal/node/probe/bin/.gitkeep
